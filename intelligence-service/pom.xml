<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.singularity</groupId>
		<artifactId>singularity-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>intelligence-service</artifactId>
	<name>intelligence-service</name>
	<description>
		ChatSession/ChatMessage/ChatEvent/CodeNote/UsageEvent/UsageLog and the AI-generation/code-insight/idea-
		clarifier/usage-insights pipeline. Its own Postgres database, its own Flyway history. Keeps its own copy
		of the Firebase/session-cookie/CSRF/rate-limit security chain rather than delegating it to
		gateway-service — see WebSecurityConfig's javadoc for why. Calls account-service (plan limits, user
		lookups) and workspace-service (project membership, file read/write, project summaries) via Feign,
		since it owns neither User nor Project.
	</description>

	<dependencies>
		<!-- CODE_REVIEW.md DEP-036: liveness/readiness for the Kubernetes deploy pipeline, exposed only on
		     management.server.port (below in application.yaml) - never reachable through the public gateway path
		     or any Service the Cloudflare tunnel forwards, since that separate port has no Service pointing at it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>com.singularity</groupId>
			<artifactId>common-lib</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Spring Boot 4 moved FlywayAutoConfiguration out of the core autoconfigure jar into this dedicated
		     module - same gotcha account-service/workspace-service already hit. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<version>0.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- StepVerifier + VirtualTimeScheduler for SseHeartbeatTest - reactor-core itself is already transitive
		     (Spring AI's WebClient usage), no version needed here since it's managed by the reactor-bom Spring
		     Boot's own dependency management imports. -->
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- Firebase Authentication (Identity Platform) - session-cookie verification only, same as account-
		     service/workspace-service. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!-- spring-cloud-starter-openfeign is NOT declared here - it's already transitive via common-lib. -->
		<!-- Every AI call this service makes - build generation, code insight, idea clarification, project
		     naming - version managed by the root pom.xml's spring-ai-bom import. -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-openai</artifactId>
		</dependency>
		<!-- GraalJS, to run the Babel parser that checks a build turn's files before they are saved (llm/SyntaxCheck).
		     Pure Java on a stock JVM (interpreted), so it also loads on the Alpine image, where a native parser built
		     against glibc would not. js-community is a pom that brings in the language and its runtime. -->
		<dependency>
			<groupId>org.graalvm.polyglot</groupId>
			<artifactId>polyglot</artifactId>
			<version>${graalvm.version}</version>
		</dependency>
		<dependency>
			<groupId>org.graalvm.polyglot</groupId>
			<artifactId>js-community</artifactId>
			<version>${graalvm.version}</version>
			<type>pom</type>
			<scope>runtime</scope>
		</dependency>
		<!-- The Babel parser itself: the published @babel/parser npm package as a WebJar, read off the classpath by
		     llm/SyntaxCheck. Its lib/index.js is self-contained, so the @babel/types jar its pom asks for (by a
		     version range) is left out. -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>babel__parser</artifactId>
			<version>${babel-parser.version}</version>
			<scope>runtime</scope>
			<exclusions>
				<exclusion>
					<groupId>org.webjars.npm</groupId>
					<artifactId>babel__types</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- .env lives at the repo root, not this module's directory - same as every other service. -->
					<workingDirectory>${project.parent.basedir}</workingDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
