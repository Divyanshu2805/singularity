<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.singularity</groupId>
	<artifactId>singularity-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>singularity-parent</name>
	<description>
		Reactor parent for the Singularity backend: a Gateway and Eureka in front of three domain services
		(account, workspace, intelligence) that share common-lib. See docs/architecture/ for the shape.
	</description>

	<!--
		Module order matters only for readability here — Maven's reactor resolves the real build order from
		inter-module dependencies.
	-->
	<modules>
		<module>common-lib</module>
		<module>discovery-service</module>
		<module>gateway-service</module>
		<module>account-service</module>
		<module>workspace-service</module>
		<module>intelligence-service</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<spring-ai.version>2.0.0-M1</spring-ai.version>
		<graalvm.version>25.4.4.1.1</graalvm.version>
		<babel-parser.version>7.29.9</babel-parser.version>
		<!-- 2025.1.2 ("Oakwood") is the first Spring Cloud release train compatible with Spring Boot 4.1.0. -->
		<spring-cloud.version>2025.1.3</spring-cloud.version>
		<!--
			Security patch overrides of versions Spring Boot 4.1.0's BOM manages (an advisory scan of the runtime
			classpath on 2026-10-05 found each fixed in the version below). Delete one when the Boot version in use
			catches up to it. Run the whole reactor after changing any: Netty and Tomcat sit under every service.
		-->
		<tomcat.version>11.0.25</tomcat.version>
		<netty.version>4.2.17.Final</netty.version>
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<postgresql.version>42.7.12</postgresql.version>
		<freemarker.version>2.3.35</freemarker.version>
		<httpcore5.version>5.4.3</httpcore5.version>
		<httpclient5.version>5.6.3</httpclient5.version>
		<log4j2.version>2.25.5</log4j2.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				Two libraries no BOM here manages, pinned to patched versions: Bouncy Castle arrives through
				spring-cloud-starter (1.81.1) and Apache HttpClient 4 through Eureka's client (4.5.3, the version with
				the cross-site-scripting advisory; firebase-admin already uses 4.5.14).
			-->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>1.85</version>
			</dependency>
			<dependency>
				<groupId>org.apache.httpcomponents</groupId>
				<artifactId>httpclient</artifactId>
				<version>4.5.14</version>
			</dependency>
			<!--
				Imported before spring-cloud-dependencies (import order matters here: for the same
				groupId:artifactId, the first-declared managed version wins) because spring-cloud-dependencies
				2025.1.2 separately manages io.fabric8:kubernetes-client-api at 7.4.1 for its own
				spring-cloud-starter-kubernetes-* modules (which nothing here uses) — left unpinned, that
				silently wins over kubernetes-client 6.13.4's own matching component versions and fails at
				runtime with NoClassDefFoundError (a mismatched kubernetes-client + kubernetes-client-api pair
				on the classpath), not at compile time.
			-->
			<dependency>
				<groupId>io.fabric8</groupId>
				<artifactId>kubernetes-client-bom</artifactId>
				<version>6.13.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<executions>
						<execution>
							<id>default-compile</id>
							<phase>compile</phase>
							<goals>
								<goal>compile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok-mapstruct-binding</artifactId>
										<version>0.2.0</version>
									</path>
									<path>
										<groupId>org.mapstruct</groupId>
										<artifactId>mapstruct-processor</artifactId>
										<version>${org.mapstruct.version}</version>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
						<execution>
							<id>default-testCompile</id>
							<phase>test-compile</phase>
							<goals>
								<goal>testCompile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok-mapstruct-binding</artifactId>
										<version>0.2.0</version>
									</path>
									<path>
										<groupId>org.mapstruct</groupId>
										<artifactId>mapstruct-processor</artifactId>
										<version>${org.mapstruct.version}</version>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
