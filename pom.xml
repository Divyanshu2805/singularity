<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.vibecraft</groupId>
	<artifactId>vibecraft-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>vibecraft-parent</name>
	<description>
		Reactor parent for the vibecraft microservices migration. See docs/architecture/ and
		C:\Users\divya\.claude\plans\glistening-swinging-crane.md for the target shape. Modules are added
		incrementally, one per migration phase — see legacy-monolith's module comment below for the
		strangler-fig fallback this reactor exists to support.
	</description>

	<!--
		Module order matters only for readability here — Maven's reactor resolves the real build order from
		inter-module dependencies. legacy-monolith is the untouched original backend, kept as a normal module
		so the whole tree still builds and boots as one reactor while services are extracted from it one at a
		time (see the migration plan's Phase 0-4 breakdown). It is deleted only once nothing depends on it.
	-->
	<modules>
		<module>common-lib</module>
		<module>discovery-service</module>
		<module>gateway-service</module>
		<module>account-service</module>
		<module>workspace-service</module>
		<module>intelligence-service</module>
		<module>legacy-monolith</module>
	</modules>

	<properties>
		<java.version>25</java.version>
		<org.mapstruct.version>1.6.3</org.mapstruct.version>
		<spring-ai.version>2.0.0-M1</spring-ai.version>
		<!-- 2025.1.2 ("Oakwood") is the first Spring Cloud release train compatible with Spring Boot 4.1.0. -->
		<spring-cloud.version>2025.1.2</spring-cloud.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!--
				Imported before spring-cloud-dependencies (import order matters here: for the same
				groupId:artifactId, the first-declared managed version wins) because spring-cloud-dependencies
				2025.1.2 separately manages io.fabric8:kubernetes-client-api at 7.4.1 for its own
				spring-cloud-starter-kubernetes-* modules (which nothing here uses) — left unpinned, that
				silently wins over kubernetes-client 6.13.4's own matching component versions and fails at
				runtime with NoClassDefFoundError (a mismatched kubernetes-client + kubernetes-client-api pair
				on the classpath), not at compile time.
			-->
			<dependency>
				<groupId>io.fabric8</groupId>
				<artifactId>kubernetes-client-bom</artifactId>
				<version>6.13.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<executions>
						<execution>
							<id>default-compile</id>
							<phase>compile</phase>
							<goals>
								<goal>compile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok-mapstruct-binding</artifactId>
										<version>0.2.0</version>
									</path>
									<path>
										<groupId>org.mapstruct</groupId>
										<artifactId>mapstruct-processor</artifactId>
										<version>${org.mapstruct.version}</version>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
						<execution>
							<id>default-testCompile</id>
							<phase>test-compile</phase>
							<goals>
								<goal>testCompile</goal>
							</goals>
							<configuration>
								<annotationProcessorPaths>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok</artifactId>
									</path>
									<path>
										<groupId>org.projectlombok</groupId>
										<artifactId>lombok-mapstruct-binding</artifactId>
										<version>0.2.0</version>
									</path>
									<path>
										<groupId>org.mapstruct</groupId>
										<artifactId>mapstruct-processor</artifactId>
										<version>${org.mapstruct.version}</version>
									</path>
								</annotationProcessorPaths>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
