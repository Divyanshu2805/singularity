<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.singularity</groupId>
		<artifactId>singularity-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>workspace-service</artifactId>
	<name>workspace-service</name>
	<description>
		Project/ProjectMember/ProjectFile/Preview/PreviewSession and the K8s/MinIO/Redis live-preview pipeline.
		Its own Postgres database, its own Flyway history. Keeps its own copy of the Firebase/session-cookie/
		CSRF/rate-limit security chain rather than delegating it to gateway-service — see WebSecurityConfig's
		javadoc for why. Calls account-service via Feign for anything User/Plan-shaped, since it owns neither,
		and exposes /internal/v1/** to intelligence-service (membership, project summaries, file reads and
		writes).
	</description>

	<dependencies>
		<!-- CODE_REVIEW.md DEP-036: liveness/readiness for the Kubernetes deploy pipeline, exposed only on
		     management.server.port (below in application.yaml) - never reachable through the public gateway path
		     or any Service the Cloudflare tunnel forwards, since that separate port has no Service pointing at it. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>com.singularity</groupId>
			<artifactId>common-lib</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Spring Boot 4 moved FlywayAutoConfiguration out of the core autoconfigure jar into this dedicated
		     module - same gotcha account-service already hit. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.mapstruct</groupId>
			<artifactId>mapstruct</artifactId>
			<version>${org.mapstruct.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok-mapstruct-binding</artifactId>
			<version>0.2.0</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!-- QA-02: the first full-servlet-filter-chain test in this codebase (real SessionAuthFilter, CSRF,
		     @PreAuthorize) - see FullChainFileAccessTest's own header for why this is safe against the
		     Windows-timezone/Postgres gotcha every other backend test in this repo avoids @SpringBootTest for. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Firebase Authentication (Identity Platform) - session-cookie verification only, same as account-service. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!-- spring-cloud-starter-openfeign is NOT declared here - it's already transitive via common-lib
		     (see common-lib/pom.xml). This module is only the first to actually define a @FeignClient. -->
		<dependency>
			<groupId>io.minio</groupId>
			<artifactId>minio</artifactId>
			<version>8.6.0</version>
		</dependency>
		<!-- Pinned explicitly - io.minio:minio otherwise resolves a Gradle-metadata-only okhttp:5.1.0 transitively
		     (documented gotcha, docs/local-development/). -->
		<dependency>
			<groupId>com.squareup.okhttp3</groupId>
			<artifactId>okhttp</artifactId>
			<version>5.5.0</version>
		</dependency>
		<!-- Talks to the runner-pod cluster live previews run in (k8s/runner-pods.yml). Resolves correctly only
		     because the root pom.xml already imports kubernetes-client-bom ahead of spring-cloud-dependencies -
		     see its comment there. -->
		<dependency>
			<groupId>io.fabric8</groupId>
			<artifactId>kubernetes-client</artifactId>
			<version>6.13.4</version>
		</dependency>
		<!-- Routes hostname -> runner-pod for the preview proxy (proxy/index.js) and tracks preview idle time. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<!-- CODE_REVIEW.md AI-05: RevisionPublisherIntegrationTest proves the CAS in
		     ProjectRepository.casAdvanceCurrentRevision actually serializes concurrent publishes against a real
		     Postgres, and that restore reproduces exact bytes through a real MinIO - both are exactly the kind of
		     real transactional/storage interaction a mocked MinioClient/repository cannot demonstrate. No version
		     pinned here - managed transitively via spring-boot-dependencies' own testcontainers-bom import. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-minio</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- .env lives at the repo root, not this module's directory - same as every other service. -->
					<workingDirectory>${project.parent.basedir}</workingDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
